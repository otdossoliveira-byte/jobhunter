# === Telegram ===
# Token obtido com o @BotFather
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui
# Chat ID do usuário ou grupo que vai receber os alertas
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui

# === Banco de Dados ===
DATABASE_URL=sqlite:///database/jobhunter.db

# === Valores sugeridos no prompt interativo ===
# A pessoa pode aceitar apertando Enter, ou digitar outro cargo/cidade na hora.
DEFAULT_CARGO=assistente administrativo
DEFAULT_CIDADE=Salvador

# Onde os perfis de busca salvos ficam guardados
PERFIS_FILE=perfis/perfis.json

# === Comportamento do robô ===
# Tempo de espera (segundos) entre requisições, para não sobrecarregar os sites
DELAY_MIN=2
DELAY_MAX=5
# Rodar o navegador sem interface gráfica (True) ou visível para debug (False)
HEADLESS=True
